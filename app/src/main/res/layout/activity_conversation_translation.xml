<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    android:orientation="vertical">

    <!-- 顶部栏：返回 / 标题 / 更多 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/conversation_back"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_conv_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/conversation_title"
            android:textColor="@color/conv_text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/clearButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/conversation_clear"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_conv_trash" />
    </LinearLayout>

    <!-- 语言选择行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/sourceLanguageChip"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_conv_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minWidth="118dp"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/sourceLanguageText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/conversation_source_default"
                android:textColor="@color/conv_text_primary"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/conversation_select_language"
                android:src="@drawable/ic_conv_chevron" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/swapLanguageButton"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/text_translation_swap"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_home_swap" />

        <LinearLayout
            android:id="@+id/targetLanguageChip"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_conv_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minWidth="118dp"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/targetLanguageText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/conversation_target_default"
                android:textColor="@color/conv_text_primary"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/conversation_target_default"
                android:src="@drawable/ic_conv_chevron" />
        </LinearLayout>
    </LinearLayout>

    <!-- 对话区 -->
    <ScrollView
        android:id="@+id/conversationScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <LinearLayout
            android:id="@+id/conversationContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp" />
    </ScrollView>

    <!-- 状态提示（准备进度 / 错误），平时隐藏 -->
    <TextView
        android:id="@+id/engineStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textColor="@color/conv_text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/aiNoticeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/conversation_ai_notice"
        android:textColor="@color/conv_text_tertiary"
        android:textSize="12sp" />

    <ImageButton
        android:id="@+id/micButton"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_conv_mic"
        android:contentDescription="@string/conversation_mic_hint"
        android:padding="20dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_conv_mic" />

    <TextView
        android:id="@+id/micHintText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="22dp"
        android:gravity="center"
        android:text="@string/conversation_mic_hint"
        android:textColor="@color/conv_text_secondary"
        android:textSize="13sp" />

</LinearLayout>
