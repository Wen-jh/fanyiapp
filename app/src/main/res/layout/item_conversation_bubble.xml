<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_conversation_bubble"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bubbleSourceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#8C8C92"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/bubbleTranslatedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/bubblePlayButton"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_conversation_play"
        android:contentDescription="播放译文"
        android:padding="8dp"
        android:src="@drawable/ic_conversation_play" />

</LinearLayout>
