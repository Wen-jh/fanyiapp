<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_conv_bubble"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="12dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bubbleSourceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/conv_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/bubbleTranslatedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/conv_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/bubblePlayButton"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_conv_play"
        android:contentDescription="@string/conversation_play"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_conversation_play" />

</LinearLayout>
